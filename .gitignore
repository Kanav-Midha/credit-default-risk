# Data — never commit. Reproduce with `make data`.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Model artefacts. Boosters (~25 MB) and OOF predictions are regenerable
# from `make train`; the small metric files are the evidence for the README
# and are tracked.
models/*
!models/.gitkeep
!models/cv_metrics.json
!models/feature_importance.csv
*.pkl
*.joblib
*.txt.model

# Reports: keep figures and metric files (small, reviewable), drop the rest.
reports/*
!reports/.gitkeep
!reports/figures/
!reports/metrics.json
!reports/sensitivity.csv
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml
.ipynb_checkpoints/
mlruns/
optuna.db

# Secrets
.env
kaggle.json
*.pem

# OS / editor
.DS_Store
.idea/
.vscode/

# Personal study notes — not part of the deliverable
LEARNING_PLAN.md
NOTES/
