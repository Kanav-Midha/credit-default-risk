# Data — never commit. Reproduce with `make data`.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Model artefacts
models/*
!models/.gitkeep
*.pkl
*.joblib
*.txt.model

# Reports: keep figures + metrics (small, reviewable), drop the rest
reports/*
!reports/figures/
!reports/.gitkeep
reports/figures/*
!reports/figures/.gitkeep

